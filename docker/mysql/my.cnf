# ============================================
# CẤU HÌNH MySQL - MY.CNF
# ============================================
# File cấu hình tối ưu MySQL cho ứng dụng Web Bán Hàng
# Được thiết kế để xử lý import dữ liệu lớn
# ============================================

[mysqld]

# -----------------------------------------
# TỐI ƯU HIỆU NĂNG CHO IMPORT DỮ LIỆU LỚN
# -----------------------------------------
# Kích thước gói tối đa cho phép (1GB - cho import file SQL lớn)
max_allowed_packet = 1G

# Bộ đệm InnoDB (1GB - tăng hiệu năng đọc/ghi)
innodb_buffer_pool_size = 1G

# Kích thước file log InnoDB (256MB)
innodb_log_file_size = 256M

# Tối ưu ghi log (2 = ghi mỗi giây, nhanh hơn nhưng có rủi ro mất 1 giây data)
innodb_flush_log_at_trx_commit = 2

# Phương thức ghi dữ liệu (O_DIRECT = bypass OS cache, tốt cho RAM lớn)
innodb_flush_method = O_DIRECT

# -----------------------------------------
# TẮT BINARY LOG KHI IMPORT (NHANH HƠN)
# -----------------------------------------
# Không ghi binary log, giúp import nhanh hơn đáng kể
skip-log-bin

# -----------------------------------------
# CẤU HÌNH KẾT NỐI
# -----------------------------------------
# Số kết nối đồng thời tối đa
max_connections = 200

# Thời gian chờ trước khi đóng kết nối không hoạt động (giây)
wait_timeout = 600

# Thời gian chờ cho kết nối interactive (giây)
interactive_timeout = 600

# -----------------------------------------
# QUERY CACHE (ĐÃ NGỪNG TRONG MySQL 8.0)
# -----------------------------------------
# Đã bị loại bỏ trong MySQL 8.0, giữ lại để tham khảo
# query_cache_type = 1
# query_cache_size = 128M

# -----------------------------------------
# BẢNG TẠM
# -----------------------------------------
# Kích thước tối đa bảng tạm trong RAM
tmp_table_size = 256M

# Kích thước tối đa bảng MEMORY
max_heap_table_size = 256M

# -----------------------------------------
# BỘ ĐỆM SẮP XẾP VÀ JOIN
# -----------------------------------------
# Bộ đệm cho thao tác sắp xếp (ORDER BY)
sort_buffer_size = 4M

# Bộ đệm cho thao tác JOIN
join_buffer_size = 4M

# Bộ đệm đọc tuần tự
read_buffer_size = 2M

# Bộ đệm đọc ngẫu nhiên
read_rnd_buffer_size = 4M

# -----------------------------------------
# BỘ KÝ TỰ - HỖ TRỢ TIẾNG VIỆT
# -----------------------------------------
# Sử dụng UTF-8 4 byte (hỗ trợ emoji và tiếng Việt đầy đủ)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# -----------------------------------------
# TÌM KIẾM FULLTEXT - HỖ TRỢ TIẾNG VIỆT
# -----------------------------------------
# Độ dài từ tối thiểu cho tìm kiếm fulltext (2 ký tự cho tiếng Việt)
ft_min_word_len = 2
innodb_ft_min_token_size = 2

# ============================================
# CẤU HÌNH CLIENT
# ============================================
[client]
# Bộ ký tự mặc định cho client
default-character-set = utf8mb4
